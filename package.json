{
  "name": "tireflow-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && node --env-file=.env.local --test .test-dist/tests/auth-foundation.test.js .test-dist/tests/organizational-context.test.js .test-dist/tests/minimal-rbac.test.js .test-dist/tests/pilot-web-foundation.test.js .test-dist/tests/invoice-extraction.test.js .test-dist/tests/search-normalization.test.js .test-dist/tests/service-order-rules.test.js",
    "bootstrap:pilot": "tsc --project tsconfig.test.json && node --env-file=.env.local .test-dist/scripts/bootstrap-pilot.js",
    "demo:seed": "tsc --project tsconfig.test.json && node --env-file=.env.local .test-dist/scripts/demo-seed.js",
    "usability:seed": "tsc --project tsconfig.test.json && node --env-file=.env.local .test-dist/scripts/seed-usability-catalog.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.24"
  }
}
