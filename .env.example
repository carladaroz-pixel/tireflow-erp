# Runtime pooled connection. Replace only in an ignored local environment file.
DATABASE_URL="POOLED_CONNECTION_STRING"

# Direct connection for migrations and administrative operations.
DIRECT_DATABASE_URL="DIRECT_CONNECTION_STRING"

# Generate a high-entropy value locally. Never commit the real secret.
AUTH_SECRET="GENERATED_SECRET"

# Explicit development/pilot bootstrap. Never commit the real password.
BOOTSTRAP_ADMIN_NAME="PILOT_ADMIN_NAME"
BOOTSTRAP_ADMIN_EMAIL="PILOT_ADMIN_EMAIL"
BOOTSTRAP_ADMIN_PASSWORD="LOCAL_SECRET_PASSWORD"
BOOTSTRAP_ORGANIZATION_NAME="PILOT_ORGANIZATION_NAME"
BOOTSTRAP_ORGANIZATION_SLUG="pilot-organization"
BOOTSTRAP_STORE_NAME="PILOT_STORE_NAME"
BOOTSTRAP_STORE_CODE="MAIN"

# Set to true only for an explicit local credential reset, then remove it.
BOOTSTRAP_RESET_PASSWORD="false"

# Optional invoice extraction provider. Keep real values only in .env.local.
AI_PROVIDER=""
AI_API_KEY=""
AI_INVOICE_MODEL=""
MAX_INVOICE_FILE_SIZE_MB="10"
